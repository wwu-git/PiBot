    "package:linux": "pnpm package --linux",
    "package:release": "pnpm package --release",
    "smoke:renderer": "electron ../../tools/dev/renderer-smoke.cjs out",
    "smoke:owner": "node ../../tools/dev/owner-smoke.mjs ."
