{
  "name": "pibot",
  "version": "0.0.4",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "pnpm": ">=12.14.0 <13"
  },
  "scripts": {
    "dev": "pnpm --filter @pibot/desktop dev",
    "pibot": "node apps/cli/bin/pibot.mjs",
    "build": "pnpm --filter @pibot/desktop build",
    "package:mac": "pnpm --filter @pibot/desktop package:mac",
    "package:win": "pnpm --filter @pibot/desktop package:win",
    "typecheck": "node tools/dev/tsc-build.ts && node tools/dev/typecheck-extras.ts && tsc --noEmit -p tools/dev/tsconfig.json && tsc --noEmit -p tools/pibot-dev/tsconfig.json && tsc --noEmit -p tools/fake-llm/tsconfig.json && tsc --noEmit -p tests/e2e/tsconfig.json && tsc --noEmit -p tools/e2e/tsconfig.json && node tools/dev/tsc-optional.ts tools/codex/tsconfig.json tools/eval/tsconfig.json tools/ui-driver/release/tsconfig.json",
    "lint": "biome check . && node tools/dev/prompts-gen.ts --check && biome check --config-path tools/biome.json tools && node scripts/sync-agent-docs.mjs --check && node tools/dev/builtin-pack.ts check && node tools/dev/builtin-tool-names.ts && node tools/dev/check-i18n-keys.ts && node tools/dev/domain-boundaries.ts && node tools/dev/run-as-node-check.ts && node tools/dev/capability-check.ts && node tools/dev/tool-attributes.ts && node tools/dev/tsconfig-references.ts --check && node packages/ui/scripts/generate-tokens.ts --check",
    "format": "biome format --write .",
    "test": "vitest run --passWithNoTests",
    "sync:agents": "node scripts/sync-agent-docs.mjs",
    "gen:prompts": "node tools/dev/prompts-gen.ts",
    "codex": "node tools/dev/internal-tool.ts tools/codex/index.ts",
    "check": "node tools/dev/check.ts",
    "check:no-install": "pnpm typecheck && pnpm lint && pnpm probe:policy && pnpm test",
    "check:changed": "node tools/dev/check-changed.ts",
    "probe:policy": "node --import ./tools/dev/ts-hooks.mjs tools/dev/policy-matrix/matrix.ts",
    "app:package": "pnpm --filter @pibot/desktop package --dir && pnpm cache:prune",
    "app:run": "node tools/dev/app.ts",
    "cache:prune": "node tools/dev/prune-backups.ts",
    "fake-llm": "node tools/fake-llm/index.ts",
    "acceptance:release": "node tools/dev/internal-tool.ts tools/ui-driver/release/index.ts",
    "acceptance:chat": "node tests/e2e/chat/index.ts",
    "acceptance:acp": "node tests/e2e/acp/loader.mjs",
    "acceptance:connected-app": "node tests/e2e/connected-app/index.ts",
    "acceptance:group-workflow": "node tests/e2e/group-workflow/index.ts",
    "acceptance:group-plan": "node tests/e2e/group-plan/index.ts",
    "acceptance:routines": "node tests/e2e/routines/index.ts",
    "acceptance:routines:artifacts": "node tests/e2e/routines/artifacts.mjs",
    "ui": "node tools/dev/internal-tool.ts tools/ui/index.ts",
    "db": "node tools/dev/db.ts",
    "builtin:pack": "node tools/dev/builtin-pack.ts",
    "cache:stats": "node tools/dev/prompt-cache.ts",
    "perf:tools": "node tools/dev/perf-tools.ts",
    "tool-plane:digest": "node tools/dev/tool-plane-digest.ts",
    "eval": "node tools/dev/internal-tool.ts tools/eval/index.ts",
    "package": "pnpm --filter @pibot/desktop package && pnpm cache:prune",
    "package:linux": "pnpm --filter @pibot/desktop package:linux",
    "package:all": "pnpm --filter @pibot/desktop package --all",
    "package:release": "pnpm --filter @pibot/desktop package:release",
    "package:mac:x64": "pnpm --filter @pibot/desktop package --mac --x64",
    "package:mac:arm64": "pnpm --filter @pibot/desktop package --mac --arm64",
    "runner:package": "node apps/runner/scripts/package.ts",
    "stats:downloads": "node tools/stats/downloads.ts",
    "stats:usage": "node tools/stats/usage.ts",
    "ui:drive": "node tools/dev/internal-tool.ts tools/ui-driver/index.ts",
    "ui:sweep": "node tools/dev/internal-tool.ts tools/ui-driver/sweep.ts",
    "verify": "node tools/dev/verify.ts",
    "smoke": "pnpm --filter @pibot/desktop smoke:renderer && pnpm --filter @pibot/desktop smoke:owner",
    "e2e": "tsc --noEmit -p tools/e2e/tsconfig.json && node tools/e2e/index.mts",
    "pibot-dev": "node --import ./tools/dev/ts-hooks.mjs tools/pibot-dev/index.ts",
    "role-catalog:build": "node --import ./tools/dev/ts-hooks.mjs tools/dev/role-catalog/build.ts",
    "role-catalog:sign": "node --import ./tools/dev/ts-hooks.mjs tools/dev/role-catalog/sign.ts",
    "role-catalog:verify": "node --import ./tools/dev/ts-hooks.mjs tools/dev/role-catalog/verify.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
