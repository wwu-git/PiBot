{
  "name": "@pibot/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "pibot": {
    "layer": "L3"
  },
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/core/env.ts",
    "./portable": "./src/portable/index.ts",
    "./portable/metro-shims": "./src/portable/metro-shims.cjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --ignoreConfig --noEmit --strict --noUncheckedIndexedAccess --target ES2023 --module ESNext --moduleResolution bundler --skipLibCheck --types node scripts/probe.ts",
    "probe": "node scripts/probe.ts"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "@pibot/protocol-base": "workspace:*",
    "@pibot/secrets": "workspace:*",
    "typebox": "1.3.27",
    "zod": "4.6.5"
  }
}
